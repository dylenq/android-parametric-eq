# Copy to keystore.properties (git-ignored) for a real release build. scripts/create-keystore.sh
# writes storeFile and keyAlias for you. The EQ_KEYSTORE_* environment variables are the alternative.
storeFile=/absolute/path/to/release.jks
keyAlias=eq
storePassword=
# Optional: only when the key has its own password (defaults to storePassword).
# keyPassword=
